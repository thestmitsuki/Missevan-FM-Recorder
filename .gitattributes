# 统一行尾策略：仅影响未来提交，不重写已有文件（未执行 add --renormalize）
* text=auto

# 代码/文本文件统一 LF（仓库与检出均 LF，消除 Windows CRLF 差异噪音）
*.rs text eol=lf
*.toml text eol=lf
*.vue text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# 无扩展名关键文件（Windows 编辑器易写 CRLF；bash source / makepkg 拒绝 CRLF）
PKGBUILD text eol=lf
Cargo.lock text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.icns binary
*.exe binary
*.dll binary
*.wav binary
*.m4a binary
*.mp3 binary
*.zip binary
