# ── 依赖与构建产物（构建时重新生成，不入库）──
node_modules/
dist/
src-tauri/target/
src-tauri/gen/
*.tsbuildinfo
# vue-tsc -b composite 模式生成的声明文件
src/**/*.d.ts
!src/env.d.ts
!src/types/vue-material-3.d.ts
vite.config.d.ts
*.d.ts.map

# ── 运行时数据（含用户数据，不入库）──
src-tauri/recordings/
src-tauri/config/

# ── 环境变量 ──
.env
.env.*
!.env.example

# ── 日志 ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── 测试产物与缓存 ──
test-results/
playwright-report/
coverage/
coverage.*
.eslintcache
.cache/

# ── 本地化文件 ──
*.local
*.local.json

# ── IDE / OS ──
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── 本地工具配置（含本机路径，不入库）──
.claude/
.superpowers/
